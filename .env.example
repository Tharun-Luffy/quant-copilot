# ==============================================================================
# Database Configuration (PostgreSQL + pgvector)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quant_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Standard PostgreSQL connection string (psycopg2 / sync drivers)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quant_copilot

# Asynchronous PostgreSQL connection string (asyncpg / SQLAlchemy async)
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/quant_copilot

# Docker internal network database connection string (if running server in Docker)
DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/quant_copilot

# ==============================================================================
# Redis Configuration (Redis 7 Alpine - Cache & State Store)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# Standard Redis connection string
REDIS_URL=redis://localhost:6379/0

# Docker internal network Redis connection string (if running server in Docker)
REDIS_URL_DOCKER=redis://redis:6379/0
